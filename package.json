{
  "name": "@noorahealth/synclaire",
  "version": "0.1.0",
  "description": "Offline-first local database and sync for React Native on expo-sqlite, wire- and file-compatible with WatermelonDB sync.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./expo": {
      "types": "./dist/expo/index.d.ts",
      "react-native": "./src/expo/index.ts",
      "import": "./dist/expo/index.js",
      "require": "./dist/expo/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "react-native": "./src/react/index.tsx",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit --project differential",
    "test:unit": "vitest run --project unit",
    "test:differential": "vitest run --project differential",
    "test:backend": "bash scripts/backend-up.sh && vitest run --project backend",
    "bench": "node --import tsx bench/run.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "fixtures:watermelon": "node --import tsx scripts/prepare-watermelon-fixture.ts",
    "fixtures:frontend": "node --import tsx scripts/export-frontend-fixtures.ts",
    "example:control": "node --import tsx scripts/device-control-server.ts",
    "example:ios": "bash scripts/run-example-ios.sh",
    "example:android": "bash scripts/run-example-android.sh",
    "example:bare:ios": "bash scripts/run-example-bare-ios.sh",
    "example:bare:android": "bash scripts/run-example-bare-android.sh"
  },
  "peerDependencies": {
    "expo-sqlite": ">=15",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "expo-sqlite": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nozbe/watermelondb": "^0.27.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "better-sqlite3": "^13.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
